---
import WaitlistLeave from '../../../components/WaitlistLeave.astro'
import { handleLeave } from '../../../lib/waitlist-leave'

export const prerender = false

// Every outcome answers 200: Astro's i18n fallback (lt → en) redirects any /lt/ response >= 300 to the English
// page, which would drop a POST and switch language. The outcome is in the page (data-state), never in the status.
const result = await handleLeave(Astro.request, Astro.url, Astro.clientAddress, 'lt')
Astro.response.headers.set('Cache-Control', 'private, no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---

<WaitlistLeave state={result.state} token={result.token} />
