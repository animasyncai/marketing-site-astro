---
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import SiteMeta from '../components/SiteMeta.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { SUPPORTED_LANGUAGES, getLanguageFromUrl } from '../utils/i18n.js'

const {
  title = 'Withinly',
  description = 'We help you understand your emotional patterns and relationships with depth, nuance, and an AI companion who truly gets the human experience.',
  url = Astro.site,
  image = 'social-preview-image.png',
  author = 'Withinly Team',
} = Astro.props

// The page's language comes from its URL (/lt/… is Lithuanian), so assistive technology reads it in the right voice.
const lang = getLanguageFromUrl(Astro.url.pathname) as keyof typeof SUPPORTED_LANGUAGES
const { dir } = SUPPORTED_LANGUAGES[lang]
---

<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!-- Favicons and App Icons -->
    <!-- Modern browsers prefer SVG, but we provide fallbacks for older browsers -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Apple Touch Icon for iOS devices -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Web App Manifest for PWA support -->
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Theme color for browser UI -->
    <meta name="theme-color" content="#ffffff" />

    <!-- Optimized font loading -->
    <!-- Preconnect to Google Fonts for faster DNS resolution and connection setup -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load fonts with display=swap to prevent FOIT (Flash of Invisible Text) -->
    <!-- This ensures text is visible immediately with fallback fonts, then swaps when custom fonts load -->
    <link
      href="https://fonts.googleapis.com/css2?family=Chivo:ital,wght@0,100..900;1,100..900&family=David+Libre:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <SiteMeta title={title} description={description.substring(0, 160)} url={url} image={image} author={author} />
    <!-- Fathom - beautiful, simple website analytics -->
    <script src="https://cdn.usefathom.com/script.js" data-site="BJECGCIG" defer></script>
    <!-- / Fathom -->
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <Header />
    <main id="main-content" class="min-h-screen" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Smooth in-page scrolling only for people who have not asked for reduced motion (E-067) */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* Fragment targets (the skip link, the header links and CTAs) land just below the sticky header: its height (h-16
     plus a 1px border) and 24px. The browser's own fragment navigation does the scrolling, updates the hash and moves
     the keyboard focus start point; <main> takes focus itself (tabindex="-1") so the skip link lands inside it. */
  main,
  :global(section[id]) {
    scroll-margin-top: calc(4rem + 1px + 24px);
  }

  main:focus {
    outline: none;
  }

  /* Ensure proper focus management */
  *:focus-visible {
    outline: 2px solid #7c3aed;
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Optimized typography and font rendering */
  body {
    font-feature-settings:
      'rlig' 1,
      'calt' 1;
  }

  /* Ensure smooth font rendering for all text */
  /* Font smoothing is already applied in _general.scss, but ensuring it's set here for consistency */
  * {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
</style>
