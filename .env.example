# Withinly marketing site — environment variables.
# This list is the schema in astro.config.mjs (`env.schema`): every name below is read at runtime from the server
# environment, and a missing required one fails `npm run build`. Never put a real value in this file.

# Mailjet account (required). Same key pair as the api's.
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Mailjet contact list that holds the early-access waitlist (required).
MAILJET_LIST_ID=

# The api's waitlist-confirmation webhook: Bearer token (required) and URL (optional; defaults to
# https://api.withinly.app/api/webhook/waitlist-confirmation-email).
WAITLIST_WEBHOOK_TOKEN=
WAITLIST_WEBHOOK_URL=

# Exact origins allowed to POST to this site, comma-separated (required). Every origin that serves the forms,
# e.g. https://withinly.app,https://www.withinly.app (add http://localhost:4321 for local development).
SIGNUP_ALLOWED_ORIGINS=
