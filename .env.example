# Withinly Environment Variables

# Site Configuration
SITE_URL=https://withinly.app
SITE_NAME=Withinly

# Email Service (Mailjet)
MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_API_SECRET=your_mailjet_api_secret_here
MAILJET_LIST_ID=your-mailjet-list-id

# Sign-up (required): exact origins allowed to POST /api/signup, comma-separated.
# Unset refuses every sign-up with 403. Set every origin that serves the form, e.g. https://withinly.app,https://www.withinly.app
SIGNUP_ALLOWED_ORIGINS=http://localhost:4321

# Development Settings
NODE_ENV=development

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Security (Optional)
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=5